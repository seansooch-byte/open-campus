// Cloudflare: one Worker on its own hostname, serving dist/ as static files: the library app at the
// root, the catalog at /catalog/, the About page at /about/. `pnpm ship` assembles dist/
// (tools/site/stage.sh) and deploys; a bare `wrangler deploy` would ship whatever dist/ last held.
// It created the DNS record and certificate for campus.seansooch.dev on first run.
{
  "name": "open-campus",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "campus.seansooch.dev", "custom_domain": true }]
}
