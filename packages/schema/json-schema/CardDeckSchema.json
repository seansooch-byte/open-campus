{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "topic_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "verification": {
      "type": "object",
      "properties": {
        "drafted_by": {
          "type": "string",
          "enum": [
            "claude",
            "codex",
            "grok",
            "sean"
          ]
        },
        "verified_by": {
          "type": "string",
          "enum": [
            "claude",
            "codex",
            "grok",
            "sean"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fixed",
            "disputed"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "drafted_by",
        "verified_by",
        "model",
        "date",
        "result"
      ],
      "additionalProperties": false
    },
    "cards": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "front": {
            "type": "string",
            "minLength": 1
          },
          "back": {
            "type": "string",
            "minLength": 1
          },
          "codes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*(?:[-.][A-Z0-9]+)*$"
            }
          },
          "clinical": {
            "default": false,
            "type": "boolean"
          },
          "sean_review": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ]
          },
          "verification": {
            "type": "object",
            "properties": {
              "drafted_by": {
                "type": "string",
                "enum": [
                  "claude",
                  "codex",
                  "grok",
                  "sean"
                ]
              },
              "verified_by": {
                "type": "string",
                "enum": [
                  "claude",
                  "codex",
                  "grok",
                  "sean"
                ]
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              "result": {
                "type": "string",
                "enum": [
                  "pass",
                  "fixed",
                  "disputed"
                ]
              },
              "notes": {
                "type": "string"
              }
            },
            "required": [
              "drafted_by",
              "verified_by",
              "model",
              "date",
              "result"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "front",
          "back",
          "clinical"
        ],
        "additionalProperties": false
      }
    },
    "example": {
      "type": "boolean"
    }
  },
  "required": [
    "topic_id",
    "cards"
  ],
  "additionalProperties": false
}
