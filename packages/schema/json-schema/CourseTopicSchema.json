{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "codes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*(?:[-.][A-Z0-9]+)*$"
      }
    },
    "requires": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "prose",
          "cards",
          "mcq",
          "math",
          "code",
          "open",
          "notebook",
          "ledger",
          "sim",
          "structure",
          "brief",
          "audio",
          "portfolio",
          "proof"
        ]
      }
    },
    "prerequisites": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "id",
    "title",
    "codes",
    "requires",
    "prerequisites"
  ],
  "additionalProperties": false
}
