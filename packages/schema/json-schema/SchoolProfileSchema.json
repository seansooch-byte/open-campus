{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "degree": {
      "type": "string",
      "enum": [
        "MD",
        "DO"
      ]
    },
    "state": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "facts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "as_of": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        },
        "required": [
          "key",
          "value",
          "source_url",
          "as_of"
        ],
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "drafted_by": {
          "type": "string",
          "enum": [
            "claude",
            "codex",
            "grok",
            "sean"
          ]
        },
        "verified_by": {
          "type": "string",
          "enum": [
            "claude",
            "codex",
            "grok",
            "sean"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fixed",
            "disputed"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "drafted_by",
        "verified_by",
        "model",
        "date",
        "result"
      ],
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "degree",
    "state",
    "website",
    "facts"
  ],
  "additionalProperties": false
}
