{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:[-.][A-Z0-9]+)*$"
    },
    "level": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "parent": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:[-.][A-Z0-9]+)*$"
    },
    "weight": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 100
    },
    "note": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "code",
    "level",
    "title"
  ],
  "additionalProperties": false
}
