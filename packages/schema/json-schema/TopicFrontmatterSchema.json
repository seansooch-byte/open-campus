{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "diagrams": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "file": {
            "type": "string",
            "pattern": "^diagrams\\/(?:[a-zA-Z0-9_-]+\\/)*[a-zA-Z0-9_-]+\\.(svg|mmd|smi)$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "svg",
              "mermaid",
              "smiles"
            ]
          },
          "alt": {
            "type": "string",
            "minLength": 1
          },
          "caption": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "file",
          "kind",
          "alt"
        ],
        "additionalProperties": false
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "updated": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "clinical": {
      "default": false,
      "type": "boolean"
    },
    "sean_review": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ]
    },
    "verification": {
      "type": "object",
      "properties": {
        "drafted_by": {
          "type": "string",
          "enum": [
            "claude",
            "codex",
            "grok",
            "sean"
          ]
        },
        "verified_by": {
          "type": "string",
          "enum": [
            "claude",
            "codex",
            "grok",
            "sean"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fixed",
            "disputed"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "drafted_by",
        "verified_by",
        "model",
        "date",
        "result"
      ],
      "additionalProperties": false
    },
    "example": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "diagrams",
    "version",
    "updated",
    "clinical"
  ],
  "additionalProperties": false
}
