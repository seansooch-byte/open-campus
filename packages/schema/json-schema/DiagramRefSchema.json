{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "file": {
      "type": "string",
      "pattern": "^diagrams\\/(?:[a-zA-Z0-9_-]+\\/)*[a-zA-Z0-9_-]+\\.(svg|mmd|smi)$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "svg",
        "mermaid",
        "smiles"
      ]
    },
    "alt": {
      "type": "string",
      "minLength": 1
    },
    "caption": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "file",
    "kind",
    "alt"
  ],
  "additionalProperties": false
}
