{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}-\\d{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "credits": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "block": {
      "type": "string",
      "enum": [
        "general-education",
        "major-core",
        "major-elective",
        "supporting"
      ]
    },
    "tier": {
      "type": "string",
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3",
        "T4",
        "T5"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "anchors": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "standard": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "codes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*(?:[-.][A-Z0-9]+)*$"
            }
          }
        },
        "required": [
          "standard"
        ],
        "additionalProperties": false
      }
    },
    "prerequisites": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "topics": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "codes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*(?:[-.][A-Z0-9]+)*$"
            }
          },
          "requires": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "prose",
                "cards",
                "mcq",
                "math",
                "code",
                "open",
                "notebook",
                "ledger",
                "sim",
                "structure",
                "brief",
                "audio",
                "portfolio",
                "proof"
              ]
            }
          },
          "prerequisites": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "objectives": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "title",
          "codes",
          "requires",
          "prerequisites"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "code",
    "title",
    "credits",
    "block",
    "tier",
    "anchors",
    "prerequisites",
    "topics"
  ],
  "additionalProperties": false
}
