{
  "name": "open-campus",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && pnpm --filter @open-campus/ui --filter @open-campus/web run typecheck",
    "build": "pnpm --filter @open-campus/web build",
    "stage": "sh tools/site/stage-library.sh",
    "ship": "sh tools/site/stage-library.sh && npx --yes wrangler@latest deploy",
    "test": "vitest run",
    "validate": "pnpm --silent --filter @open-campus/tools check",
    "coverage": "pnpm --silent --filter @open-campus/tools coverage",
    "course-plan": "pnpm --silent --filter @open-campus/tools course-plan",
    "clinical:packet": "pnpm --silent --filter @open-campus/tools clinical:packet",
    "clinical:apply": "pnpm --silent --filter @open-campus/tools clinical:apply",
    "lint:originality": "pnpm --silent --filter @open-campus/tools lint:originality"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
